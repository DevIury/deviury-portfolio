---
import { ViewTransitions } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	ogType?: string;
	lang?: string;
}

const {
	title,
	description = "DevIury - Web Designer profissional em Curvelo/MG. Crio sites modernos, rápidos e otimizados para converter visitantes em clientes. Orçamento grátis.",
	ogImage = "/og-image.svg",
	ogType = "website",
	lang = "pt-BR"
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, 'https://deviury.pages.dev');
const ogImageURL = ogImage.startsWith('http') ? ogImage : `https://deviury.pages.dev${ogImage}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/webp" href="/favicon-deviury.webp" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="apple-touch-icon" href="/favicon-deviury.webp" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#00E676" />

		<!-- SEO Principal -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="web designer curvelo, criar site curvelo, desenvolvedor web curvelo, landing page curvelo, site institucional curvelo, design web minas gerais, criar site barato curvelo, agência web curvelo" />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="DevIury" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="pt-BR" href={canonicalURL.href} />

		<!-- Geo Meta -->
		<meta name="geo.region" content="MG" />
		<meta name="geo.placename" content="Curvelo" />
		<meta name="geo.position" content="-18.7553;-44.4297" />
		<meta name="ICBM" content="-18.7553, -44.4297" />

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content="DevIury - Web Designer em Curvelo" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- JSON-LD Organization + ProfessionalService -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "ProfessionalService",
			"@id": "https://deviury.pages.dev/#organization",
			"name": "DevIury - Web Designer",
			"description": "Web Designer profissional em Curvelo/MG. Crio sites modernos, rápidos e otimizados para converter visitantes em clientes.",
			"url": "https://deviury.pages.dev",
			"image": "https://deviury.pages.dev/iury-profissional.webp",
			"logo": "https://deviury.pages.dev/logo-deviury.webp",
			"telephone": "+5538998894811",
			"email": "contato.iury.dev@gmail.com",
			"founder": {
				"@type": "Person",
				"name": "DevIury",
				"url": "https://deviury.pages.dev",
				"image": "https://deviury.pages.dev/iury-profissional.webp",
				"jobTitle": "Web Designer",
				"sameAs": [
					"https://wa.me/5538998894811",
					"https://www.instagram.com/dev.iury.wp/",
					"https://www.linkedin.com/in/deviury/"
				]
			},
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Curvelo",
				"addressRegion": "MG",
				"addressCountry": "BR"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": -18.7553,
				"longitude": -44.4297
			},
			"areaServed": [
				{
					"@type": "City",
					"name": "Curvelo",
					"containedInPlace": { "@type": "State", "name": "Minas Gerais" }
				},
				{
					"@type": "City",
					"name": "Belo Horizonte",
					"containedInPlace": { "@type": "State", "name": "Minas Gerais" }
				},
				{
					"@type": "City",
					"name": "São Paulo",
					"containedInPlace": { "@type": "State", "name": "São Paulo" }
				}
			],
			"serviceType": ["Web Design", "Criação de Sites", "Landing Page", "Site Institucional", "Desenvolvimento Web", "SEO", "E-commerce"],
			"priceRange": "$$",
			"openingHours": "Mo-Su 08:00-20:00",
			"sameAs": [
				"https://wa.me/5538998894811",
				"https://www.instagram.com/dev.iury.wp/",
				"https://www.linkedin.com/in/deviury/"
			],
			"aggregateRating": {
				"@type": "AggregateRating",
				"ratingValue": "5",
				"reviewCount": "8"
			}
		}
		</script>

		<!-- JSON-LD FAQ -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "Quanto custa criar um site em Curvelo?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "O investimento varia conforme a necessidade. Sites institucionais começam a partir de R$ 800. Landing pages a partir de R$ 500. Orçamento personalizado e sem compromisso pelo WhatsApp."
					}
				},
				{
					"@type": "Question",
					"name": "Quanto tempo leva para criar um site?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Um site institucional leva de 5 a 10 dias úteis. Landing pages de 3 a 5 dias. Projetos maiores com funcionalidades específicas podem levar de 2 a 4 semanas."
					}
				},
				{
					"@type": "Question",
					"name": "Você atende empresas de outras cidades?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Sim! Atendo empresas de Curvelo, Belo Horizonte, Betim, Divinópolis e todo o estado de Minas Gerais. Atendimento 100% online disponível."
					}
				},
				{
					"@type": "Question",
					"name": "O site fica otimizado para o Google?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Sim! Todos os sites são desenvolvidos com SEO básico e avançado, incluindo otimização de velocidade, meta tags, estrutura semântica e Google Search Console."
					}
				},
				{
					"@type": "Question",
					"name": "Você faz manutenção do site após o lançamento?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Sim! Ofereço suporte contínuo para atualizações, correções e melhorias. Pacotes de manutenção mensal disponíveis."
					}
				},
				{
					"@type": "Question",
					"name": "Como faço para contratar seus serviços?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "É simples! Entre em contato pelo WhatsApp, conversemos sobre sua necessidade e eu envio uma proposta personalizada. Sem compromisso."
					}
				}
			]
		}
		</script>

		<!-- Self-hosted Inter font (no external requests) -->
		<style>
			@font-face {
				font-family: 'Inter';
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url('/fonts/inter/inter-latin-400-normal.woff2') format('woff2');
			}
			@font-face {
				font-family: 'Inter';
				font-style: normal;
				font-weight: 500;
				font-display: swap;
				src: url('/fonts/inter/inter-latin-500-normal.woff2') format('woff2');
			}
			@font-face {
				font-family: 'Inter';
				font-style: normal;
				font-weight: 600;
				font-display: swap;
				src: url('/fonts/inter/inter-latin-600-normal.woff2') format('woff2');
			}
			@font-face {
				font-family: 'Inter';
				font-style: normal;
				font-weight: 700;
				font-display: swap;
				src: url('/fonts/inter/inter-latin-700-normal.woff2') format('woff2');
			}
			@font-face {
				font-family: 'Inter';
				font-style: normal;
				font-weight: 800;
				font-display: swap;
				src: url('/fonts/inter/inter-latin-800-normal.woff2') format('woff2');
			}
		</style>

		<!-- Performance: Preload critical resources -->
		<link rel="preload" href="/iury-profissional.webp" as="image" fetchpriority="high">
		<link rel="preload" href="/logo-deviury.webp" as="image">

		<!-- DNS Prefetch for external resources -->
		<link rel="dns-prefetch" href="https://wa.me">

		<!-- Google Analytics (gated by cookie consent) -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}

			function initGA() {
				if (document.querySelector('script[src*="googletagmanager"]')) return;
				const s = document.createElement('script');
				s.async = true;
				s.src = 'https://www.googletagmanager.com/gtag/js?id=G-NSWZ3EKZX9';
				document.head.appendChild(s);
				gtag('js', new Date());
				gtag('config', 'G-NSWZ3EKZX9');
				gtag('event', 'conversion_ready', {
					page_location: window.location.href,
					page_title: document.title
				});
			}

			if (localStorage.getItem('cookieConsent') === 'accepted') {
				initGA();
			}
		</script>

		<ViewTransitions />
		<Analytics />
	</head>
	<body>
		<slot />

		<div class="cookie-consent" id="cookie-consent">
			<p>Este site usa cookies para melhorar sua experiência. Ao continuar navegando, você concorda com o uso de cookies.</p>
			<div class="cookie-buttons">
				<button class="cookie-btn cookie-accept" id="cookie-accept" aria-label="Aceitar cookies">Aceitar</button>
				<button class="cookie-btn cookie-reject" id="cookie-reject" aria-label="Recusar cookies">Recusar</button>
			</div>
		</div>

		<script>
			const cookieConsent = document.getElementById('cookie-consent');
			const cookieAccept = document.getElementById('cookie-accept');
			const cookieReject = document.getElementById('cookie-reject');

			if (!localStorage.getItem('cookieConsent')) {
				cookieConsent?.classList.add('visible');
			}

			cookieAccept?.addEventListener('click', () => {
				localStorage.setItem('cookieConsent', 'accepted');
				cookieConsent?.classList.remove('visible');
				if (typeof initGA === 'function') initGA();
			});

			cookieReject?.addEventListener('click', () => {
				localStorage.setItem('cookieConsent', 'rejected');
				cookieConsent?.classList.remove('visible');
			});

			document.querySelectorAll('a[href^="#"]').forEach(link => {
				link.addEventListener('click', (e) => {
					const href = link.getAttribute('href');
					if (href === '#') return;
					const target = document.querySelector(href);
					if (!target) return;
					e.preventDefault();
					document.body.classList.add('section-transition');
					setTimeout(() => {
						target.scrollIntoView({ behavior: 'smooth' });
						setTimeout(() => {
							document.body.classList.remove('section-transition');
						}, 120);
					}, 100);
				});
			});

			// Scroll reveal animation
			function initReveal() {
				const revealSelectors = '.reveal, .portfolio-grid .portfolio-card, .blog-grid .blog-card, .featured-card';
				const revealElements = document.querySelectorAll(revealSelectors);
				if (revealElements.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					const revealObserver = new IntersectionObserver((entries) => {
						entries.forEach(entry => {
							if (entry.isIntersecting) {
								entry.target.classList.add('revealed');
								revealObserver.unobserve(entry.target);
							}
						});
					}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
					revealElements.forEach(el => revealObserver.observe(el));
				} else {
					revealElements.forEach(el => el.classList.add('revealed'));
				}
			}
			initReveal();
			document.addEventListener('astro:page-load', initReveal);
		</script>
	</body>
</html>
<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:root {
		--primary: #00E676;
		--primary-dark: #00C853;
		--bg-dark: #0a0a0a;
		--bg-card: #111111;
		--text-white: #ffffff;
		--text-gray: #a0a0a0;
		--border: #1a1a1a;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: 'Inter', sans-serif;
		background-color: var(--bg-dark);
		color: var(--text-white);
		line-height: 1.6;
	}

	:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
		border-radius: 4px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.cookie-consent {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		background: #111;
		border-top: 1px solid var(--border);
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		z-index: 1000;
		transform: translateY(100%);
		transition: transform 0.3s ease;
	}

	.cookie-consent.visible {
		transform: translateY(0);
	}

	.cookie-consent p {
		color: var(--text-gray);
		font-size: 0.85rem;
		margin: 0;
	}

	.cookie-buttons {
		display: flex;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.cookie-btn {
		padding: 0.5rem 1rem;
		border-radius: 8px;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		border: none;
		transition: all 0.2s;
	}

	.cookie-accept {
		background: var(--primary);
		color: #000;
	}

	.cookie-reject {
		background: rgba(255, 255, 255, 0.1);
		color: var(--text-gray);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	@media (max-width: 768px) {
		.cookie-consent {
			flex-direction: column;
			text-align: center;
		}

		.cookie-buttons {
			width: 100%;
		}

		.cookie-btn {
			flex: 1;
		}
	}

	/* View Transitions */
	@keyframes fade-in {
		from { opacity: 0; }
	}

	@keyframes fade-out {
		to { opacity: 0; }
	}

	::view-transition-old(root) {
		animation: fade-out 0.1s ease-in forwards;
	}

	::view-transition-new(root) {
		animation: fade-in 0.12s ease-out;
	}

	/* Faster transitions on mobile */
	@media (max-width: 768px) {
		::view-transition-old(root) {
			animation: fade-out 0.05s ease-in forwards;
		}

		::view-transition-new(root) {
			animation: fade-in 0.06s ease-out;
		}

		body.section-transition {
			animation: fade-out 0.05s ease-in forwards;
		}

		body:not(.section-transition) {
			animation: fade-in 0.06s ease-out;
		}
	}

	/* Section navigation transitions */
	body.section-transition {
		animation: fade-out 0.1s ease-in forwards;
	}

	body:not(.section-transition) {
		animation: fade-in 0.12s ease-out;
	}

	/* Reduced motion */
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}

		::view-transition-old(root),
		::view-transition-new(root) {
			animation: none;
		}

		body.section-transition,
		body:not(.section-transition) {
			animation: none;
		}

		.reveal {
			opacity: 1 !important;
			transform: none !important;
		}
	}

	/* Scroll reveal */
	.reveal {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.reveal.revealed {
		opacity: 1;
		transform: translateY(0);
	}

	.portfolio-grid .portfolio-card,
	.blog-grid .blog-card,
	.featured-card {
		opacity: 0;
		transform: translateY(24px);
	}

	.portfolio-grid .portfolio-card.revealed,
	.blog-grid .blog-card.revealed,
	.featured-card.revealed {
		opacity: 1;
		transform: translateY(0);
	}

	.portfolio-grid .portfolio-card:nth-child(1),
	.blog-grid .blog-card:nth-child(1) { transition-delay: 0s; }
	.portfolio-grid .portfolio-card:nth-child(2),
	.blog-grid .blog-card:nth-child(2) { transition-delay: 0.08s; }
	.portfolio-grid .portfolio-card:nth-child(3),
	.blog-grid .blog-card:nth-child(3) { transition-delay: 0.16s; }
	.portfolio-grid .portfolio-card:nth-child(4),
	.blog-grid .blog-card:nth-child(4) { transition-delay: 0.24s; }
	.portfolio-grid .portfolio-card:nth-child(5),
	.blog-grid .blog-card:nth-child(5) { transition-delay: 0.32s; }
	.portfolio-grid .portfolio-card:nth-child(6),
	.blog-grid .blog-card:nth-child(6) { transition-delay: 0.4s; }
	.portfolio-grid .portfolio-card:nth-child(7),
	.blog-grid .blog-card:nth-child(7) { transition-delay: 0.48s; }
	.portfolio-grid .portfolio-card:nth-child(8),
	.blog-grid .blog-card:nth-child(8) { transition-delay: 0.56s; }
</style>
