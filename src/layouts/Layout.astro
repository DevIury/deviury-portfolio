---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "DevIury - Web Designer profissional em Curvelo/MG. Crio sites modernos, rápidos e otimizados para converter visitantes em clientes. Orçamento grátis." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, 'https://deviury.com');
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-deviury.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#00E676" />

		<!-- SEO Principal -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="web designer curvelo, criar site curvelo, desenvolvedor web curvelo, landing page curvelo, site institucional curvelo, design web minas gerais, criar site barato curvelo, agência web curvelo" />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="DevIury" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Geo Meta -->
		<meta name="geo.region" content="MG" />
		<meta name="geo.placename" content="Curvelo" />
		<meta name="geo.position" content="-18.7553;-44.4297" />
		<meta name="ICBM" content="-18.7553, -44.4297" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="DevIury | Web Designer em Curvelo/MG" />
		<meta property="og:description" content="Web Designer profissional em Curvelo/MG. Crio sites modernos, rápidos e otimizados para converter visitantes em clientes." />
		<meta property="og:url" content="https://deviury.com" />
		<meta property="og:image" content="https://deviury.com/og-image.png" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content="DevIury - Web Designer em Curvelo" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="DevIury | Web Designer em Curvelo/MG" />
		<meta name="twitter:description" content="Web Designer profissional em Curvelo/MG. Crio sites modernos, rápidos e otimizados para converter visitantes em clientes." />
		<meta name="twitter:image" content="https://deviury.com/og-image.png" />

		<!-- JSON-LD LocalBusiness -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "ProfessionalService",
			"name": "DevIury - Web Designer",
			"description": "Web Designer profissional em Curvelo/MG. Crio sites modernos, rápidos e otimizados para converter visitantes em clientes.",
			"url": "https://deviury.com",
			"image": "https://deviury.com/iury-profissional.jpeg",
			"telephone": "+5538998894811",
			"email": "contato@deviury.com",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Curvelo",
				"addressRegion": "MG",
				"addressCountry": "BR"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": -18.7553,
				"longitude": -44.4297
			},
			"areaServed": {
				"@type": "City",
				"name": "Curvelo",
				"containedInPlace": {
					"@type": "State",
					"name": "Minas Gerais"
				}
			},
			"serviceType": ["Web Design", "Criação de Sites", "Landing Page", "Site Institucional", "Desenvolvimento Web"],
			"priceRange": "$$",
			"openingHours": "Mo-Su 08:00-20:00",
			"sameAs": [
				"https://wa.me/5538998894811"
			]
		}
		</script>

		<!-- JSON-LD FAQ -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "Quanto custa criar um site em Curvelo?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "O investimento varia conforme a necessidade. Sites institucionais começam a partir de R$ 800. Landing pages a partir de R$ 500. Orçamento personalizado e sem compromisso pelo WhatsApp."
					}
				},
				{
					"@type": "Question",
					"name": "Quanto tempo leva para criar um site?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Um site institucional leva de 5 a 10 dias úteis. Landing pages de 3 a 5 dias. Projetos maiores com funcionalidades específicas podem levar de 2 a 4 semanas."
					}
				},
				{
					"@type": "Question",
					"name": "Você atende empresas de outras cidades?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Sim! Atendo empresas de Curvelo, Belo Horizonte, Betim, Divinópolis e todo o estado de Minas Gerais. Atendimento 100% online disponível."
					}
				},
				{
					"@type": "Question",
					"name": "O site fica otimizado para o Google?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Sim! Todos os sites são desenvolvidos com SEO básico e avançado, incluindo otimização de velocidade, meta tags, estrutura semântica e Google Search Console."
					}
				},
				{
					"@type": "Question",
					"name": "Você faz manutenção do site após o lançamento?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Sim! Ofereço suporte contínuo para atualizações, correções e melhorias. Pacotes de manutenção mensal disponíveis."
					}
				},
				{
					"@type": "Question",
					"name": "Como faço para contratar seus serviços?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "É simples! Entre em contato pelo WhatsApp, conversemos sobre sua necessidade e eu envio uma proposta personalizada. Sem compromisso."
					}
				}
			]
		}
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		
		<!-- Performance: Preload critical resources -->
		<link rel="preload" href="/iury-profissional.jpeg" as="image" fetchpriority="high">
		<link rel="preload" href="/logo-deviury.png" as="image">
		
		<!-- DNS Prefetch for external resources -->
		<link rel="dns-prefetch" href="https://wa.me">

		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-XXXXXXXXXX');
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:root {
		--primary: #00E676;
		--primary-dark: #00C853;
		--bg-dark: #0a0a0a;
		--bg-card: #111111;
		--text-white: #ffffff;
		--text-gray: #a0a0a0;
		--border: #1a1a1a;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: 'Inter', sans-serif;
		background-color: var(--bg-dark);
		color: var(--text-white);
		line-height: 1.6;
	}

	:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
		border-radius: 4px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
