---
interface Props {
	copyright?: string;
}

const { copyright = "2026 DevIury - Web Designer em Curvelo/MG. Todos os direitos reservados." } = Astro.props;
---

<footer>
	<div class="container">
		<p class="copyright">&copy; {copyright}</p>
	</div>
</footer>

<style>
	footer {
		padding: 1.2rem 0;
		text-align: center;
		border-top: 1px solid var(--border);
		margin-top: 20px;
	}

	.copyright {
		font-size: 0.8rem;
		color: var(--text-gray);
	}
</style>
