---
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
	message?: string;
}

const { message = "Ol%C3%A1!%20Vim%20pelo%20site%20e%20gostaria%20de%20um%20or%C3%A7amento%20para%20cria%C3%A7%C3%A3o%20de%20site." } = Astro.props;
---

<a href={`https://wa.me/5538998894811?text=${message}`} target="_blank" rel="noopener noreferrer" class="floating-whatsapp" aria-label="Fale comigo no WhatsApp">
	<WhatsAppIcon size={28} />
</a>

<style>
	.floating-whatsapp {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		width: 60px;
		height: 60px;
		background: linear-gradient(135deg, #00C853, #00E676, #69F0AE);
		color: #fff;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 25px rgba(0, 230, 118, 0.5);
		text-decoration: none;
		animation: pulse-whatsapp 2s infinite;
	}

	@keyframes pulse-whatsapp {
		0% { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.4); }
		70% { box-shadow: 0 0 0 15px rgba(0, 230, 118, 0); }
		100% { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0); }
	}

	@media (prefers-reduced-motion: reduce) {
		.floating-whatsapp {
			animation: none;
		}
	}
</style>
