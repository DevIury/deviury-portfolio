---
import Layout from '../../layouts/Layout.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id.replace(/\.md$/, '') },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const articleSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": post.data.title,
	"description": post.data.description,
	"datePublished": post.data.date.toISOString(),
	"author": {
		"@type": "Person",
		"name": "DevIury",
		"url": "https://deviury.com"
	},
	"publisher": {
		"@type": "Organization",
		"name": "DevIury - Web Designer",
		"logo": {
			"@type": "ImageObject",
			"url": "https://deviury.com/logo-deviury.webp"
		}
	},
	"image": post.data.image ? `https://deviury.com${post.data.image}` : "https://deviury.com/og-image.png",
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": `https://deviury.com/blog/${post.id.replace(/\.md$/, '')}`
	}
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": "https://deviury.com"
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Blog",
			"item": "https://deviury.com/blog"
		},
		{
			"@type": "ListItem",
			"position": 3,
			"name": post.data.title
		}
	]
};
---

<Layout
	title={`${post.data.title} | Blog - DevIury`}
	description={post.data.description}
	ogImage={post.data.image}
	ogType="article"
>
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<header class="header">
		<nav class="nav">
			<a href="/" class="logo"><img src="/logo-deviury.webp" alt="DevIury" height="82"></a>
			<ul class="nav-links">
				<li><a href="/#servicos">Serviços</a></li>
				<li><a href="/#sobre">Sobre</a></li>
				<li><a href="/#portfolio">Portfólio</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/#contato">Contato</a></li>
			</ul>
			<a href="https://wa.me/5538998894811?text=Ol%C3%A1!%20Vim%20pelo%20blog%20e%20gostaria%20de%20um%20or%C3%A7amento." target="_blank" rel="noopener noreferrer" class="nav-cta">Fale Comigo</a>
			<button class="menu-btn" id="menu-btn" aria-label="Abrir menu de navegação">
				<span class="menu-btn__line"></span>
				<span class="menu-btn__line"></span>
				<span class="menu-btn__line"></span>
			</button>
		</nav>
	</header>

	<div class="overlay" id="overlay"></div>
	<aside class="sidebar" id="sidebar" aria-label="Menu de navegação mobile">
		<button class="sidebar__close" id="sidebar-close" aria-label="Fechar menu de navegação">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M18 6L6 18M6 6l12 12"/>
			</svg>
		</button>
		<a href="/" class="sidebar__logo"><img src="/logo-deviury.webp" alt="DevIury - Página inicial" height="60"></a>
		<nav class="sidebar__nav">
			<span class="sidebar__label">Navegação</span>
			<a href="/#servicos" class="sidebar__link">Serviços</a>
			<a href="/#sobre" class="sidebar__link">Sobre</a>
			<a href="/#portfolio" class="sidebar__link">Portfólio</a>
			<a href="/blog" class="sidebar__link">Blog</a>
			<a href="/#contato" class="sidebar__link">Contato</a>
		</nav>
		<a href="https://wa.me/5538998894811?text=Ol%C3%A1!%20Vim%20pelo%20blog%20e%20gostaria%20de%20um%20or%C3%A7amento." target="_blank" rel="noopener noreferrer" class="sidebar__cta">
			<WhatsAppIcon size={22} />
			Fale Comigo
		</a>
	</aside>

	<article class="post-page">
		<div class="container">
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li><a href="/blog">Blog</a></li>
					<li aria-current="page">{post.data.title}</li>
				</ol>
			</nav>

			<div class="post-header">
				{post.data.image && (
					<img class="post-featured-image" src={post.data.image} alt={post.data.title} width="800" height="400" loading="eager" />
				)}
				<div class="post-meta">
					<time datetime={post.data.date.toISOString()}>
						{post.data.date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
					</time>
					<span class="post-separator">·</span>
					<span>{readingTime} min de leitura</span>
					<span class="post-separator">·</span>
					<span class="post-author">DevIury</span>
				</div>
				<div class="post-tags">
					{post.data.tags.map(tag => <span class="tag">{tag}</span>)}
				</div>
				<h1>{post.data.title}</h1>
				<p class="post-description">{post.data.description}</p>
			</div>

			<div class="post-content">
				<Content />
			</div>
		</div>
	</article>

	<section class="cta">
		<div class="cta-bg">
			<div class="cta-orb cta-orb-1"></div>
			<div class="cta-orb cta-orb-2"></div>
		</div>
		<div class="container">
			<div class="cta-content">
				<span class="section-tag">Contato</span>
				<h2>Precisa de um Site?</h2>
				<p class="cta-subtitle">Fale comigo e receba um orçamento para seu site em Curvelo!</p>
				<div class="cta-buttons">
					<a href="https://wa.me/5538998894811?text=Ol%C3%A1!%20Vim%20pelo%20blog%20e%20gostaria%20de%20um%20or%C3%A7amento%20para%20cria%C3%A7%C3%A3o%20de%20site." target="_blank" rel="noopener noreferrer" class="btn btn-primary">
						<WhatsAppIcon size={20} />
						Fale no WhatsApp
					</a>
				</div>
			</div>
		</div>
	</section>

	<footer>
		<div class="container">
			<p class="copyright">&copy; 2026 DevIury - Web Designer em Curvelo/MG. Todos os direitos reservados.</p>
		</div>
	</footer>

	<a href="https://wa.me/5538998894811?text=Ol%C3%A1!%20Vim%20pelo%20blog%20e%20gostaria%20de%20um%20or%C3%A7amento." target="_blank" rel="noopener noreferrer" class="floating-whatsapp" aria-label="Fale comigo no WhatsApp">
		<WhatsAppIcon size={28} />
	</a>

	<script>
		const menuBtn = document.getElementById('menu-btn');
		const sidebar = document.getElementById('sidebar');
		const overlay = document.getElementById('overlay');
		const sidebarClose = document.getElementById('sidebar-close');

		function openMenu() {
			sidebar?.classList.add('open');
			overlay?.classList.add('visible');
			document.body.style.overflow = 'hidden';
			sidebarClose?.focus();
		}

		function closeMenu() {
			sidebar?.classList.remove('open');
			overlay?.classList.remove('visible');
			document.body.style.overflow = '';
			menuBtn?.focus();
		}

		menuBtn?.addEventListener('click', openMenu);
		overlay?.addEventListener('click', closeMenu);
		sidebarClose?.addEventListener('click', closeMenu);

		sidebar?.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				closeMenu();
				return;
			}
			if (e.key !== 'Tab' || !sidebar) return;
			const focusable = sidebar.querySelectorAll('a[href], button, [tabindex]:not([tabindex="-1"])');
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (e.shiftKey) {
				if (document.activeElement === first) {
					e.preventDefault();
					last.focus();
				}
			} else {
				if (document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
		});

		document.querySelectorAll('.sidebar__link').forEach(link => {
			link.addEventListener('click', closeMenu);
		});
	</script>
</Layout>

<style>
	.post-page {
		padding: 8rem 1.5rem 4rem;
	}

	.breadcrumbs {
		max-width: 800px;
		margin: 0 auto 2rem;
	}

	.breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		font-size: 0.85rem;
	}

	.breadcrumbs li:not(:last-child)::after {
		content: '/';
		margin-left: 0.5rem;
		color: var(--text-gray);
	}

	.breadcrumbs a {
		color: var(--text-gray);
		text-decoration: none;
		transition: color 0.2s;
	}

	.breadcrumbs a:hover {
		color: var(--primary);
	}

	.breadcrumbs [aria-current="page"] {
		color: var(--text-white);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-gray);
		text-decoration: none;
		font-size: 0.9rem;
		margin-bottom: 2rem;
		transition: color 0.2s;
	}

	.back-link:hover {
		color: var(--primary);
	}

	.post-featured-image {
		width: 100%;
		height: auto;
		border-radius: 16px;
		margin-bottom: 2rem;
		object-fit: cover;
		max-height: 400px;
	}

	.post-header {
		max-width: 800px;
		margin: 0 auto 3rem;
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--text-gray);
		margin-bottom: 1rem;
	}

	.post-separator {
		opacity: 0.4;
	}

	.post-author {
		color: var(--primary);
		font-weight: 500;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.tag {
		padding: 0.25rem 0.75rem;
		background: rgba(0, 230, 118, 0.1);
		border: 1px solid rgba(0, 230, 118, 0.2);
		border-radius: 50px;
		font-size: 0.75rem;
		color: var(--primary);
		font-weight: 500;
	}

	.post-header h1 {
		font-size: 2.5rem;
		font-weight: 800;
		line-height: 1.2;
		margin-bottom: 1rem;
	}

	.post-description {
		font-size: 1.15rem;
		color: var(--text-gray);
		line-height: 1.6;
	}

	.post-content {
		max-width: 800px;
		margin: 0 auto;
	}

	.post-content :global(h2) {
		font-size: 1.5rem;
		font-weight: 700;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		color: #fff;
	}

	.post-content :global(h3) {
		font-size: 1.25rem;
		font-weight: 600;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		color: var(--primary);
	}

	.post-content :global(p) {
		color: var(--text-gray);
		line-height: 1.8;
		margin-bottom: 1rem;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		color: var(--text-gray);
		margin-bottom: 1rem;
		padding-left: 1.5rem;
	}

	.post-content :global(li) {
		margin-bottom: 0.5rem;
		line-height: 1.7;
	}

	.post-content :global(strong) {
		color: #fff;
	}

	.post-content :global(a) {
		color: var(--primary);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s;
	}

	.post-content :global(a:hover) {
		border-bottom-color: var(--primary);
	}

	.cta {
		margin: 2rem 1rem 0;
		padding: 4rem 1.5rem;
		border-radius: 24px;
		background: var(--bg-card);
		border: 1px solid var(--border);
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.cta-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.cta-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
	}

	.cta-orb-1 {
		width: 300px;
		height: 300px;
		background: rgba(0, 230, 118, 0.15);
		top: -100px;
		right: -100px;
	}

	.cta-orb-2 {
		width: 200px;
		height: 200px;
		background: rgba(0, 200, 83, 0.1);
		bottom: -50px;
		left: -50px;
	}

	.cta-content {
		position: relative;
		z-index: 1;
	}

	.section-tag {
		display: inline-block;
		padding: 0.4rem 1rem;
		background: rgba(0, 230, 118, 0.1);
		border: 1px solid rgba(0, 230, 118, 0.2);
		border-radius: 50px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--primary);
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 1rem;
	}

	.cta h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	.cta-subtitle {
		color: var(--text-gray);
		margin-bottom: 2rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.5rem;
		border-radius: 10px;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: all 0.2s;
	}

	.btn-primary {
		background: linear-gradient(135deg, #00C853, #00E676, #69F0AE);
		color: #fff;
	}

	.floating-whatsapp {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		width: 60px;
		height: 60px;
		background: linear-gradient(135deg, #00C853, #00E676, #69F0AE);
		color: #fff;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 25px rgba(0, 230, 118, 0.5);
		text-decoration: none;
		animation: pulse-whatsapp 2s infinite;
	}

	@keyframes pulse-whatsapp {
		0% { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.4); }
		70% { box-shadow: 0 0 0 15px rgba(0, 230, 118, 0); }
		100% { box-shadow: 0 0 0 0 rgba(0, 230, 118, 0); }
	}

	footer {
		padding: 1.2rem 0;
		text-align: center;
		border-top: 1px solid var(--border);
		margin-top: 20px;
	}

	.copyright {
		font-size: 0.8rem;
		color: var(--text-gray);
	}

	.header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: rgba(10, 10, 10, 0.8);
		backdrop-filter: blur(20px);
		border-bottom: 1px solid var(--border);
	}

	.nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.logo img {
		height: 82px;
		width: auto;
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		list-style: none;
	}

	.nav-links a {
		color: var(--text-gray);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: color 0.3s;
	}

	.nav-links a:hover {
		color: var(--primary);
	}

	.nav-cta {
		padding: 0.6rem 1.2rem;
		background: var(--primary);
		color: #000;
		text-decoration: none;
		border-radius: 8px;
		font-weight: 600;
		font-size: 0.9rem;
		transition: all 0.3s;
	}

	.menu-btn {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 5px;
	}

	.menu-btn__line {
		width: 24px;
		height: 2px;
		background: #fff;
	}

	.overlay {
		display: none;
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.7);
		z-index: 200;
	}

	.overlay.visible {
		display: block;
	}

	.sidebar {
		position: fixed;
		top: 0;
		right: -300px;
		width: 300px;
		height: 100vh;
		background: #111;
		z-index: 300;
		padding: 1.5rem;
		transition: right 0.3s ease;
		display: flex;
		flex-direction: column;
	}

	.sidebar.open {
		right: 0;
	}

	.sidebar__close {
		position: absolute;
		top: 1.25rem;
		right: 1.25rem;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.08);
		color: #fff;
		cursor: pointer;
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 12px;
	}

	.sidebar__logo {
		display: flex;
		justify-content: center;
		margin-top: 1rem;
		margin-bottom: 1rem;
	}

	.sidebar__nav {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 2rem;
	}

	.sidebar__label {
		font-size: 0.7rem;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.25);
		text-transform: uppercase;
		letter-spacing: 1.5px;
		padding: 0 1.25rem;
		margin-bottom: 0.5rem;
	}

	.sidebar__link {
		display: block;
		padding: 0.75rem 1.25rem;
		color: #fff;
		text-decoration: none;
		font-size: 1rem;
		font-weight: 500;
		border-radius: 8px;
	}

	.sidebar__cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2rem;
		padding: 1.4rem 1.5rem;
		background: linear-gradient(135deg, #00C853, #00E676, #69F0AE);
		color: #fff;
		text-decoration: none;
		border-radius: 16px;
		font-size: 1.15rem;
		font-weight: 700;
	}

	@media (prefers-reduced-motion: reduce) {
		.floating-whatsapp {
			animation: none;
		}
	}

	@media (max-width: 768px) {
		.nav-links {
			display: none;
		}

		.nav-cta {
			display: none;
		}

		.menu-btn {
			display: flex;
		}

		.post-header h1 {
			font-size: 1.75rem;
		}

		.cta {
			margin: 2rem 1rem 0;
			padding: 4rem 1.5rem;
			border-radius: 24px;
		}

		.cta h2 {
			font-size: 1.75rem;
		}
	}
</style>
