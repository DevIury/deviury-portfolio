			<a href="https://wa.me/5538998894811?text=Ol%C3%A1!%20Vim%20pelo%20blog%20e%20gostaria%20de%20um%20or%C3%A7amento." target="_blank" rel="noopener noreferrer" class="nav-cta">Fale Comigo</a>
			<button class="menu-btn" id="menu-btn" aria-label="Abrir menu de navegação">
				<span class="menu-btn__line"></span>
