	}

	.post-header h1 {
		font-size: 2.5rem;
		font-weight: 800;
		line-height: 1.2;
		margin-bottom: 1rem;
	}

	.post-description {
		font-size: 1.15rem;
		color: var(--text-gray);
		line-height: 1.6;
	}

	.post-content {
		max-width: 800px;
