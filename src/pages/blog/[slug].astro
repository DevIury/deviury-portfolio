---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id.replace(/\.md$/, '') },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
	.filter(p => p.id !== post.id)
	.sort((a, b) => {
		const aShared = a.data.tags.filter(t => post.data.tags.includes(t)).length;
		const bShared = b.data.tags.filter(t => post.data.tags.includes(t)).length;
		return bShared - aShared;
	})
	.slice(0, 2);

const articleSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": post.data.title,
	"description": post.data.description,
	"datePublished": post.data.date.toISOString(),
	"author": {
		"@type": "Person",
		"name": "DevIury",
		"url": "https://deviury.pages.dev"
	},
	"publisher": {
		"@type": "Organization",
		"name": "DevIury - Web Designer",
		"logo": {
			"@type": "ImageObject",
			"url": "https://deviury.pages.dev/logo-deviury.webp"
		}
	},
	"image": post.data.image ? `https://deviury.pages.dev${post.data.image}` : "https://deviury.pages.dev/og-image.svg",
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": `https://deviury.pages.dev/blog/${post.id.replace(/\.md$/, '')}`
	}
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://deviury.pages.dev" },
		{ "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://deviury.pages.dev/blog" },
		{ "@type": "ListItem", "position": 3, "name": post.data.title }
	]
};
---

<Layout
	title={`${post.data.title} | Blog - DevIury`}
	description={post.data.description}
	ogImage={post.data.image}
	ogType="article"
>
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<Header whatsappMessage="Ol%C3%A1!%20Vim%20pelo%20blog%20e%20gostaria%20de%20um%20or%C3%A7amento." />

	<main id="main-content">
	<article class="post-page">
		<div class="container">
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li><a href="/blog">Blog</a></li>
					<li aria-current="page">{post.data.title}</li>
				</ol>
			</nav>

			<div class="post-header">
				{post.data.image && (
					<img class="post-featured-image" src={post.data.image} alt={post.data.title} width="800" height="400" loading="eager" />
				)}
				<div class="post-meta">
					<time datetime={post.data.date.toISOString()}>
						{post.data.date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
					</time>
					<span class="post-separator">·</span>
					<span>{readingTime} min de leitura</span>
					<span class="post-separator">·</span>
					<span class="post-author">DevIury</span>
				</div>
				<div class="post-tags">
					{post.data.tags.map(tag => <span class="tag">{tag}</span>)}
				</div>
				<h1>{post.data.title}</h1>
				<p class="post-description">{post.data.description}</p>
			</div>

			<div class="post-content">
				<Content />
			</div>

			{relatedPosts.length > 0 && (
				<div class="related-posts">
					<h2>Artigos Relacionados</h2>
					<div class="related-grid">
						{relatedPosts.map(related => (
							<a href={`/blog/${related.id.replace(/\.md$/, '')}`} class="related-card">
								<div class="related-card__image">
									<img src={related.data.image} alt={related.data.title} width="400" height="200" loading="lazy" />
								</div>
								<div class="related-card__content">
									<time datetime={related.data.date.toISOString()}>
										{related.data.date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}
									</time>
									<h3>{related.data.title}</h3>
									<span class="related-card__read">Ler artigo →</span>
								</div>
							</a>
						))}
					</div>
				</div>
			)}
		</div>
	</article>
	</main>

	<Footer />
	<FloatingWhatsApp message="Ol%C3%A1!%20Vim%20pelo%20blog%20e%20gostaria%20de%20um%20or%C3%A7amento." />
</Layout>

<style>
	.post-page {
		padding: 8rem 1.5rem 4rem;
	}

	.breadcrumbs {
		max-width: 800px;
		margin: 0 auto 2rem;
	}

	.breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		font-size: 0.85rem;
	}

	.breadcrumbs li:not(:last-child)::after {
		content: '/';
		margin-left: 0.5rem;
		color: var(--text-gray);
	}

	.breadcrumbs a {
		color: var(--text-gray);
		text-decoration: none;
		transition: color 0.2s;
	}

	.breadcrumbs a:hover {
		color: var(--primary);
	}

	.breadcrumbs [aria-current="page"] {
		color: var(--text-white);
	}

	.post-featured-image {
		width: 100%;
		height: auto;
		border-radius: 16px;
		margin-bottom: 2rem;
		object-fit: cover;
		max-height: 400px;
	}

	.post-header {
		max-width: 800px;
		margin: 0 auto 3rem;
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--text-gray);
		margin-bottom: 1rem;
	}

	.post-separator {
		opacity: 0.4;
	}

	.post-author {
		color: var(--primary);
		font-weight: 500;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.tag {
		padding: 0.25rem 0.75rem;
		background: rgba(0, 230, 118, 0.1);
		border: 1px solid rgba(0, 230, 118, 0.2);
		border-radius: 50px;
		font-size: 0.75rem;
		color: var(--primary);
		font-weight: 500;
	}

	.post-header h1 {
		font-size: 2.5rem;
		font-weight: 800;
		line-height: 1.2;
		margin-bottom: 1rem;
	}

	.post-description {
		font-size: 1.15rem;
		color: var(--text-gray);
		line-height: 1.6;
	}

	.post-content {
		max-width: 800px;
		margin: 0 auto;
	}

	.post-content :global(h2) {
		font-size: 1.5rem;
		font-weight: 700;
		margin-top: 3rem;
		margin-bottom: 1.25rem;
		color: #fff;
		line-height: 1.3;
	}

	.post-content :global(h3) {
		font-size: 1.25rem;
		font-weight: 600;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		color: var(--primary);
	}

	.post-content :global(p) {
		color: var(--text-gray);
		line-height: 1.9;
		margin-bottom: 1.5rem;
		font-size: 1.05rem;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		color: var(--text-gray);
		margin-bottom: 1.5rem;
		margin-top: 0.5rem;
		padding-left: 1.5rem;
	}

	.post-content :global(li) {
		margin-bottom: 0.6rem;
		line-height: 1.8;
	}

	.post-content :global(strong) {
		color: #fff;
		font-weight: 600;
	}

	.post-content :global(a) {
		color: var(--primary);
		text-decoration: none;
		border-bottom: 1px solid rgba(0, 230, 118, 0.3);
		transition: border-color 0.2s;
	}

	.post-content :global(a:hover) {
		border-bottom-color: var(--primary);
	}

	.post-content :global(blockquote) {
		border-left: 3px solid var(--primary);
		padding: 1rem 1.5rem;
		margin: 2rem 0;
		background: rgba(0, 230, 118, 0.05);
		border-radius: 0 12px 12px 0;
		color: var(--text-gray);
		font-style: italic;
	}

	.related-posts {
		max-width: 800px;
		margin: 4rem auto 0;
		padding-top: 3rem;
		border-top: 1px solid var(--border);
	}

	.related-posts h2 {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.related-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition: all 0.3s;
	}

	.related-card:hover {
		border-color: var(--primary);
		transform: translateY(-3px);
	}

	.related-card__image {
		aspect-ratio: 2/1;
		overflow: hidden;
	}

	.related-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.related-card__content {
		padding: 1rem;
	}

	.related-card__content time {
		font-size: 0.75rem;
		color: var(--text-gray);
	}

	.related-card__content h3 {
		font-size: 1rem;
		font-weight: 600;
		margin: 0.5rem 0;
		line-height: 1.3;
	}

	.related-card__read {
		color: var(--primary);
		font-size: 0.85rem;
		font-weight: 600;
	}

	@media (max-width: 768px) {
		.post-header h1 {
			font-size: 1.75rem;
		}

		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
