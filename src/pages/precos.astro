</style>

<script>
	document.addEventListener('astro:page-load', () => {
		// Menu toggle
		const menuBtn = document.getElementById('menu-btn');
		const sidebar = document.getElementById('sidebar');
		const overlay = document.getElementById('overlay');
		const closeBtn = document.getElementById('sidebar-close');

		function openMenu() {
			sidebar?.classList.add('active');
			overlay?.classList.add('active');
			document.body.style.overflow = 'hidden';
			closeBtn?.focus();
		}

		function closeMenu() {
			sidebar?.classList.remove('active');
			overlay?.classList.remove('active');
			document.body.style.overflow = '';
			menuBtn?.focus();
		}

		menuBtn?.addEventListener('click', openMenu);
		closeBtn?.addEventListener('click', closeMenu);
		overlay?.addEventListener('click', closeMenu);

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && sidebar?.classList.contains('active')) {
				closeMenu();
			}
		});

		// Focus trap
		if (sidebar) {
			const focusableElements = sidebar.querySelectorAll('button, a, input, select, textarea, [tabindex]:not([tabindex="-1"])');
			const first = focusableElements[0];
			const last = focusableElements[focusableElements.length - 1];

			sidebar.addEventListener('keydown', (e) => {
				if (e.key !== 'Tab') return;

				if (e.shiftKey) {
					if (document.activeElement === first) {
						e.preventDefault();
						last.focus();
					}
				} else {
					if (document.activeElement === last) {
						e.preventDefault();
						first.focus();
					}
				}
			});

			sidebar.querySelectorAll('.sidebar__link').forEach(link => {
				link.addEventListener('click', closeMenu);
			});
		}

		// FAQ toggle
		document.querySelectorAll('.faq-question').forEach(button => {
			button.addEventListener('click', () => {
				const item = button.parentElement;
				const isActive = item.classList.contains('active');
				
				document.querySelectorAll('.faq-item').forEach(faqItem => {
					faqItem.classList.remove('active');
					faqItem.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
				});
				
				if (!isActive) {
					item.classList.add('active');
					button.setAttribute('aria-expanded', 'true');
				}
			});
		});

		// Back to top
		const backToTop = document.getElementById('back-to-top');
		if (backToTop) {
			window.addEventListener('scroll', () => {
				if (window.scrollY > 500) {
					backToTop.classList.add('visible');
				} else {
					backToTop.classList.remove('visible');
				}
			});

			backToTop.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});
		}

		// Pricing toggle
		const billingToggle = document.getElementById('billing-toggle');
		const labelMonthly = document.getElementById('label-monthly');
		const labelAnnual = document.getElementById('label-annual');
		const amounts = document.querySelectorAll('.amount');
		const periods = document.querySelectorAll('.period');
		const installments = document.querySelectorAll('.installment-info');

		billingToggle?.addEventListener('change', (e) => {
			const isAnnual = e.target.checked;
			
			labelMonthly?.classList.toggle('active', !isAnnual);
			labelAnnual?.classList.toggle('active', isAnnual);

			amounts.forEach(amount => {
				amount.textContent = isAnnual ? amount.dataset.annual : amount.dataset.monthly;
			});

			periods.forEach(period => {
				period.textContent = isAnnual ? period.dataset.annual : period.dataset.monthly;
			});

			installments.forEach(info => {
				info.textContent = isAnnual ? info.dataset.annual : info.dataset.monthly;
			});
		});

		// Scroll reveal
		const observerOptions = {
			threshold: 0.1,
			rootMargin: '0px 0px -50px 0px'
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('revealed');
				}
			});
		}, observerOptions);

		document.querySelectorAll('.scroll-reveal').forEach(el => {
			observer.observe(el);
		});

		// A/B Testing System
		const ABTest = {
			variants: {
				A: {
					name: 'Controle',
					pricing: { essencial: 697, profissional: 1097, premium: null },
					ctas: { essencial: 'Começar Agora', profissional: 'Fale no WhatsApp', premium: 'Solicitar Orçamento' }
				},
				B: {
					name: 'Preço Mais Baixo',
					pricing: { essencial: 647, profissional: 1047, premium: null },
					ctas: { essencial: 'Garantir Meu Site', profissional: 'Começar Agora', premium: 'Solicitar Orçamento' }
				},
				C: {
					name: 'CTA Urgência',
					pricing: { essencial: 697, profissional: 1097, premium: null },
					ctas: { essencial: 'Últimas Vagas!', profissional: 'Vagas Limitadas', premium: 'Solicitar Orçamento' }
				}
			},

			getStoredVariant() {
				return localStorage.getItem('ab_test_pricing');
			},

			setVariant(variant) {
				localStorage.setItem('ab_test_pricing', variant);
			},

			getRandomVariant() {
				const variants = Object.keys(this.variants);
				const weights = [0.4, 0.3, 0.3]; // 40% A, 30% B, 30% C
				const random = Math.random();
				let sum = 0;
				
				for (let i = 0; i < variants.length; i++) {
					sum += weights[i];
					if (random <= sum) return variants[i];
				}
				return variants[0];
			},

			init() {
				let variant = this.getStoredVariant();
				if (!variant) {
					variant = this.getRandomVariant();
					this.setVariant(variant);
				}
				this.applyVariant(variant);
				this.trackImpression(variant);
				return variant;
			},

			applyVariant(variant) {
				const config = this.variants[variant];
				if (!config) return;

				// Update prices
				document.querySelectorAll('.pricing-card').forEach(card => {
					const plan = card.dataset.plan;
					if (plan && config.pricing[plan]) {
						const amountEl = card.querySelector('.amount');
						const monthlyPrice = config.pricing[plan];
						const annualPrice = Math.round(monthlyPrice / 12);
						
						if (amountEl) {
							amountEl.dataset.monthly = monthlyPrice;
							amountEl.dataset.annual = annualPrice;
							amountEl.textContent = monthlyPrice;
						}

						// Update installment info
						const installmentEl = card.querySelector('.installment-info');
						if (installmentEl) {
							installmentEl.dataset.monthly = `ou 12x de R$ ${annualPrice}`;
						}
					}
				});

				// Update CTAs
				document.querySelectorAll('.ab-test-cta').forEach(cta => {
					const plan = cta.dataset.plan;
					if (plan && config.ctas[plan]) {
						// Keep WhatsApp icon if it exists
						const whatsappIcon = cta.querySelector('svg');
						if (whatsappIcon) {
							cta.innerHTML = '';
							cta.appendChild(whatsappIcon);
							cta.appendChild(document.createTextNode(config.ctas[plan]));
						} else {
							cta.textContent = config.ctas[plan];
						}
					}
				});

				// Update WhatsApp links with new prices
				document.querySelectorAll('.ab-test-cta').forEach(cta => {
					const plan = cta.dataset.plan;
					if (plan && config.pricing[plan]) {
						const currentUrl = new URL(cta.href);
						const message = currentUrl.searchParams.get('text');
						if (message) {
							const newMessage = message.replace(/R\$[0-9]+/, `R$${config.pricing[plan]}`);
							currentUrl.searchParams.set('text', newMessage);
							cta.href = currentUrl.toString();
						}
					}
				});
			},

			trackImpression(variant) {
				// Track impression in localStorage
				const stats = JSON.parse(localStorage.getItem('ab_test_stats') || '{}');
				if (!stats[variant]) stats[variant] = { impressions: 0, clicks: 0 };
				stats[variant].impressions++;
				localStorage.setItem('ab_test_stats', JSON.stringify(stats));
			},

			trackClick(variant, plan) {
				const stats = JSON.parse(localStorage.getItem('ab_test_stats') || '{}');
				if (!stats[variant]) stats[variant] = { impressions: 0, clicks: 0 };
				stats[variant].clicks++;
				stats[variant][`${plan}_clicks`] = (stats[variant][`${plan}_clicks`] || 0) + 1;
				localStorage.setItem('ab_test_stats', JSON.stringify(stats));
				
				// Log for debugging
				console.log(`[A/B Test] Variant ${variant} - ${plan} clicked`);
			},

			getResults() {
				return JSON.parse(localStorage.getItem('ab_test_stats') || '{}');
			}
		};

		// Initialize A/B test
		const currentVariant = ABTest.init();
		console.log(`[A/B Test] Assigned to variant: ${currentVariant}`);

		// Track clicks on CTAs
		document.querySelectorAll('.ab-test-cta').forEach(cta => {
			cta.addEventListener('click', () => {
				const plan = cta.dataset.plan;
				ABTest.trackClick(currentVariant, plan);
			});
		});

		// Add admin shortcut to view results (press 'AB' keys)
		let abKeyPress = '';
		document.addEventListener('keydown', (e) => {
			abKeyPress += e.key.toUpperCase();
			if (abKeyPress.includes('AB')) {
				const results = ABTest.getResults();
				console.table(results);
				alert(`Resultados do A/B Test:\n\nVariante A (Controle): ${results.A?.impressions || 0} impressões, ${results.A?.clicks || 0} cliques\nVariante B (Preço Baixo): ${results.B?.impressions || 0} impressões, ${results.B?.clicks || 0} cliques\nVariante C (Urgência): ${results.C?.impressions || 0} impressões, ${results.C?.clicks || 0} cliques`);
				abKeyPress = '';
			}
			setTimeout(() => { abKeyPress = ''; }, 1000);
		});
	});
</script>