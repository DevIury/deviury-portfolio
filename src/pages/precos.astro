	.toggle-slider {
		position: absolute;
		cursor: pointer;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: var(--surface);
		border: 1px solid var(--border);
		transition: 0.3s;
		border-radius: 26px;
