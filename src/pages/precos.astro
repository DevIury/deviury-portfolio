	.discount-banner__text span {
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.discount-banner__badge {
		background: var(--primary);
		color: #000;
		padding: 0.4rem 1rem;
		border-radius: 8px;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
