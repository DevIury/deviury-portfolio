---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
---

<Layout
	title="Contact DevIury | Web Designer in Curvelo, Brazil"
	description="Get in touch with DevIury. Professional web designer in Curvelo, Brazil. Let's create the website your business needs."
	lang="en"
>
	<Header whatsappMessage="Hi!%20I%20came%20through%20the%20contact%20page%20and%20would%20like%20a%20quote." />

	<link rel="alternate" hreflang="pt-BR" href="https://deviury.com/contato" />
	<meta name="geo.region" content="MG" />
	<meta name="geo.placename" content="Curvelo, MG, Brazil" />
	<meta property="og:locale" content="en_US" />

	<section class="contact-hero">
		<div class="container">
			<span class="section-tag">Contact</span>
			<h1>Get in Touch</h1>
			<p>Let's create the website your business in Curvelo needs. I'm ready to help you take your digital presence to the next level.</p>
		</div>
	</section>

	<section class="contact-options">
		<div class="container">
			<div class="options-grid">
				<div class="option-card option-featured">
					<div class="option-icon">
						<WhatsAppIcon size={32} />
					</div>
					<h2>WhatsApp</h2>
					<p>The fastest way to get in touch. Send me a message and I'll respond within 24 hours.</p>
					<a href="https://wa.me/5538998894811?text=Hi!%20I%20came%20through%20the%20contact%20page%20and%20would%20like%20a%20quote." target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-large">
						<WhatsAppIcon size={20} />
						Talk on WhatsApp
					</a>
				</div>

				<div class="option-card">
					<div class="option-icon">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
							<polyline points="22,6 12,13 2,6"/>
						</svg>
					</div>
					<h2>Email</h2>
					<p>Prefer email? Send me a message and I'll get back to you as soon as possible.</p>
					<a href="mailto:contato@deviury.com" class="btn btn-secondary">contato@deviury.com</a>
				</div>
			</div>
		</div>
	</section>

	<section class="contact-info">
		<div class="container">
			<div class="info-grid">
				<div class="info-item">
					<div class="info-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
							<circle cx="12" cy="10" r="3"/>
						</svg>
					</div>
					<h3>Location</h3>
					<p>Curvelo, Minas Gerais<br>Brazil</p>
				</div>
				<div class="info-item">
					<div class="info-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<circle cx="12" cy="12" r="10"/>
							<polyline points="12 6 12 12 16 14"/>
						</svg>
					</div>
					<h3>Response Time</h3>
					<p>Within 24 hours<br>Monday to Sunday</p>
				</div>
				<div class="info-item">
					<div class="info-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<circle cx="12" cy="12" r="10"/>
							<line x1="2" y1="12" x2="22" y2="12"/>
							<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
						</svg>
					</div>
					<h3>Service Area</h3>
					<p>Curvelo and all of Brazil<br>100% online available</p>
				</div>
			</div>
		</div>
	</section>

	<section class="contact-cta">
		<div class="cta-bg">
			<div class="cta-orb cta-orb-1"></div>
			<div class="cta-orb cta-orb-2"></div>
		</div>
		<div class="container">
			<div class="cta-content">
				<h2>Ready to Start?</h2>
				<p>Send me a message on WhatsApp and let's discuss your project. No obligation, just a friendly conversation about your business goals.</p>
				<div class="cta-features">
					<div class="cta-feature">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
							<polyline points="22 4 12 14.01 9 11.01"/>
						</svg>
						<span>Free quote with no obligation</span>
					</div>
					<div class="cta-feature">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
							<polyline points="22 4 12 14.01 9 11.01"/>
						</svg>
						<span>Response within 24 hours</span>
					</div>
					<div class="cta-feature">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
							<polyline points="22 4 12 14.01 9 11.01"/>
						</svg>
						<span>Personalized solutions</span>
					</div>
				</div>
				<a href="https://wa.me/5538998894811?text=Hi!%20I%20came%20through%20the%20contact%20page%20and%20would%20like%20a%20quote." target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-large">
					<WhatsAppIcon size={24} />
					Send Message
				</a>
			</div>
		</div>
	</section>

	<Footer copyright="2026 DevIury - Web Designer in Curvelo, Brazil. All rights reserved." />
	<FloatingWhatsApp message="Hi!%20I%20came%20through%20the%20contact%20page%20and%20would%20like%20a%20quote." />
</Layout>

<style>
	.contact-hero {
		padding: 8rem 1.5rem 3rem;
		text-align: center;
	}

	.contact-hero h1 {
		font-size: 3rem;
		font-weight: 800;
		margin-bottom: 1rem;
		letter-spacing: -0.5px;
	}

	.contact-hero p {
		color: var(--text-gray);
		font-size: 1.1rem;
		max-width: 550px;
		margin: 0 auto;
		line-height: 1.7;
	}

	.section-tag {
		display: inline-block;
		padding: 0.4rem 1rem;
		background: rgba(0, 230, 118, 0.1);
		border: 1px solid rgba(0, 230, 118, 0.2);
		border-radius: 50px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--primary);
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 1rem;
	}

	.contact-options {
		padding: 2rem 1.5rem 4rem;
	}

	.options-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		max-width: 900px;
		margin: 0 auto;
	}

	.option-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 24px;
		padding: 3rem 2rem;
		text-align: center;
		transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
	}

	.option-card:hover {
		border-color: rgba(0, 230, 118, 0.3);
		transform: translateY(-5px);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
	}

	.option-featured {
		border-color: rgba(0, 230, 118, 0.2);
		background: linear-gradient(135deg, rgba(0, 230, 118, 0.05) 0%, var(--bg-card) 100%);
	}

	.option-icon {
		width: 70px;
		height: 70px;
		background: rgba(0, 230, 118, 0.1);
		border-radius: 18px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1.5rem;
		color: var(--primary);
		transition: all 0.3s;
	}

	.option-card:hover .option-icon {
		background: var(--primary);
		color: var(--bg-dark);
		transform: scale(1.1);
	}

	.option-card h2 {
		font-size: 1.5rem;
		font-weight: 800;
		margin-bottom: 0.75rem;
	}

	.option-card p {
		color: var(--text-gray);
		font-size: 0.95rem;
		line-height: 1.7;
		margin-bottom: 1.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.5rem;
		border-radius: 10px;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: all 0.2s;
	}

	.btn-primary {
		background: linear-gradient(135deg, #00C853, #00E676, #69F0AE);
		color: #fff;
		font-weight: 700;
	}

	.btn-primary:hover {
		background: linear-gradient(135deg, #00E676, #69F0AE, #B9F6CA);
		transform: translateY(-1px);
		box-shadow: 0 8px 30px rgba(0, 230, 118, 0.4);
	}

	.btn-secondary {
		background: transparent;
		color: var(--primary);
		border: 1px solid rgba(0, 230, 118, 0.3);
		font-weight: 600;
	}

	.btn-secondary:hover {
		border-color: var(--primary);
		background: rgba(0, 230, 118, 0.05);
	}

	.btn-large {
		padding: 1rem 2rem;
		font-size: 1rem;
	}

	.contact-info {
		padding: 2rem 1.5rem 4rem;
	}

	.info-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		max-width: 900px;
		margin: 0 auto;
	}

	.info-item {
		text-align: center;
		padding: 2rem 1.5rem;
		background: linear-gradient(160deg, rgba(25, 25, 25, 0.8) 0%, rgba(15, 15, 15, 0.6) 100%);
		border-radius: 20px;
		border: 1px solid rgba(255, 255, 255, 0.05);
		transition: all 0.4s;
	}

	.info-item:hover {
		border-color: rgba(0, 230, 118, 0.2);
		transform: translateY(-5px);
		box-shadow: 0 10px 40px rgba(0, 230, 118, 0.1);
	}

	.info-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		background: linear-gradient(135deg, rgba(0, 230, 118, 0.15) 0%, rgba(0, 200, 83, 0.05) 100%);
		border-radius: 14px;
		margin-bottom: 1.25rem;
		color: var(--primary);
		border: 1px solid rgba(0, 230, 118, 0.1);
	}

	.info-item h3 {
		font-size: 1.15rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.info-item p {
		color: var(--text-gray);
		font-size: 0.9rem;
		line-height: 1.7;
	}

	.contact-cta {
		padding: 4rem 1.5rem;
		margin: 0 1.5rem;
		border-radius: 32px;
		background: linear-gradient(160deg, rgba(30, 30, 30, 0.6) 0%, rgba(18, 18, 18, 0.8) 100%);
		position: relative;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.05);
		text-align: center;
		margin-bottom: 2rem;
	}

	.cta-bg {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.cta-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
	}

	.cta-orb-1 {
		width: 300px;
		height: 300px;
		background: rgba(0, 230, 118, 0.12);
		top: -100px;
		right: -50px;
	}

	.cta-orb-2 {
		width: 250px;
		height: 250px;
		background: rgba(0, 230, 118, 0.08);
		bottom: -80px;
		left: -30px;
	}

	.cta-content {
		position: relative;
		z-index: 1;
		max-width: 600px;
		margin: 0 auto;
	}

	.cta-content h2 {
		font-size: 2.2rem;
		font-weight: 800;
		margin-bottom: 1rem;
		letter-spacing: -0.5px;
	}

	.cta-content > p {
		color: var(--text-gray);
		margin-bottom: 2rem;
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.cta-features {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.cta-feature {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 1rem;
		background: rgba(255, 255, 255, 0.04);
		border-radius: 50px;
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.06);
	}

	.cta-feature svg {
		color: var(--primary);
		flex-shrink: 0;
	}

	@media (max-width: 768px) {
		.contact-hero h1 {
			font-size: 2rem;
		}

		.options-grid {
			grid-template-columns: 1fr;
		}

		.info-grid {
			grid-template-columns: 1fr;
		}

		.contact-cta {
			margin: 0 1rem;
			padding: 3rem 1.5rem;
			border-radius: 24px;
		}

		.cta-content h2 {
			font-size: 1.75rem;
		}

		.cta-features {
			flex-direction: column;
			align-items: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
