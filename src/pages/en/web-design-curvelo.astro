---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaSection from '../../components/CtaSection.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
---

<Layout
	title="Web Design in Curvelo, Brazil | Professional Website Developer - DevIury"
	description="DevIury - Professional web design services in Curvelo, Brazil. I create modern, fast websites optimized to convert visitors into customers."
	lang="en"
>
	<Header whatsappMessage="Hi!%20I%20came%20through%20the%20website%20and%20would%20like%20a%20quote%20for%20website%20creation." />

	<link rel="alternate" hreflang="pt-BR" href="https://deviury.com/criacao-de-sites-curvelo" />
	<meta name="geo.region" content="MG" />
	<meta name="geo.placename" content="Curvelo, MG, Brazil" />
	<meta property="og:locale" content="en_US" />

	<section class="hero">
		<div class="hero-content">
			<div class="hero-text">
				<span class="badge">Web Designer in Curvelo, Brazil</span>
				<h1>Professional Website Development in Curvelo</h1>
				<p>I create modern, fast websites optimized to convert visitors into customers. Your business in Curvelo deserves a top-level digital presence.</p>
				<div class="cta-group">
					<a href="/en/#portfolio" class="btn btn-secondary">View Projects</a>
					<a href="https://wa.me/5538998894811?text=Hi!%20I%20came%20through%20the%20website%20and%20would%20like%20a%20quote%20for%20website%20creation." target="_blank" rel="noopener noreferrer" class="btn btn-primary">
						<WhatsAppIcon size={20} />
						Talk on WhatsApp
					</a>
				</div>
			</div>
			<div class="hero-image">
				<img src="/iury-profissional.webp" alt="DevIury - Professional web designer in Curvelo, Brazil" width="400" height="400" loading="eager" fetchpriority="high">
			</div>
		</div>
	</section>

	<section class="content-seo">
		<div class="container">
			<h2>Why Choose a Local Web Designer in Curvelo?</h2>
			<p>Having a professional website is essential for any business in Curvelo looking to grow. With over 8 live websites and experience in WordPress, Elementor, and modern development, I offer personalized solutions for each client.</p>

			<h3>Web Design Services in Curvelo</h3>
			<ul class="service-list">
				<li>Corporate Websites - Professional digital presence for your business</li>
				<li>Landing Pages - Conversion-focused pages for lead generation</li>
				<li>E-commerce Websites - Complete online stores with payment systems</li>
				<li>WhatsApp Websites - WhatsApp Business integration for more sales</li>
				<li>SEO Optimization - So your website appears on Google in Curvelo and beyond</li>
			</ul>

			<h3>Service Area</h3>
			<p>I serve businesses in <strong>Curvelo</strong>, <strong>Belo Horizonte</strong>, <strong>Betim</strong>, <strong>Divinopolis</strong>, and the entire state of <strong>Minas Gerais</strong>. 100% online service available for all of Brazil.</p>
		</div>
	</section>

	<section class="faq">
		<div class="container">
			<span class="section-tag">FAQ</span>
			<h2>Frequently Asked Questions About Web Design in Curvelo</h2>
			<div class="faq-accordion">
				<div class="faq-item">
					<button class="faq-question" aria-expanded="false" aria-controls="faq-answer-1">
						<span class="faq-number">01</span>
						<span class="faq-title">How much does it cost to create a website in Curvelo?</span>
						<svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polyline points="6 9 12 15 18 9"/>
						</svg>
					</button>
					<div class="faq-answer" id="faq-answer-1" role="region">
						<div class="faq-answer-inner">
							<p>The investment for website creation in Curvelo starts from R$ 800 for corporate websites and R$ 500 for landing pages. The final price depends on the features and design you need. Custom quote with no obligation via WhatsApp.</p>
						</div>
					</div>
				</div>
				<div class="faq-item">
					<button class="faq-question" aria-expanded="false" aria-controls="faq-answer-2">
						<span class="faq-number">02</span>
						<span class="faq-title">How long does it take to create a website?</span>
						<svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polyline points="6 9 12 15 18 9"/>
						</svg>
					</button>
					<div class="faq-answer" id="faq-answer-2" role="region">
						<div class="faq-answer-inner">
							<p>A corporate website takes 5 to 10 business days. Landing pages 3 to 5 days. The deadline is set after layout and content approval.</p>
						</div>
					</div>
				</div>
				<div class="faq-item">
					<button class="faq-question" aria-expanded="false" aria-controls="faq-answer-3">
						<span class="faq-number">03</span>
						<span class="faq-title">Is the website optimized for Google?</span>
						<svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polyline points="6 9 12 15 18 9"/>
						</svg>
					</button>
					<div class="faq-answer" id="faq-answer-3" role="region">
						<div class="faq-answer-inner">
							<p>Yes! All websites are developed with optimized SEO, including meta tags, loading speed, semantic structure, and Google Search Console setup.</p>
						</div>
					</div>
				</div>
				<div class="faq-item">
					<button class="faq-question" aria-expanded="false" aria-controls="faq-answer-4">
						<span class="faq-number">04</span>
						<span class="faq-title">Do you serve businesses from other cities?</span>
						<svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polyline points="6 9 12 15 18 9"/>
						</svg>
					</button>
					<div class="faq-answer" id="faq-answer-4" role="region">
						<div class="faq-answer-inner">
							<p>Yes! I serve businesses in Curvelo in person and from anywhere in Brazil online. Belo Horizonte, Betim, Divinopolis, and the entire state of Minas Gerais.</p>
						</div>
					</div>
				</div>
				<div class="faq-item">
					<button class="faq-question" aria-expanded="false" aria-controls="faq-answer-5">
						<span class="faq-number">05</span>
						<span class="faq-title">Does the website work well on mobile?</span>
						<svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polyline points="6 9 12 15 18 9"/>
						</svg>
					</button>
					<div class="faq-answer" id="faq-answer-5" role="region">
						<div class="faq-answer-inner">
							<p>Yes! All websites are developed with responsive design, working perfectly on phones, tablets, and desktops.</p>
						</div>
					</div>
				</div>
				<div class="faq-item">
					<button class="faq-question" aria-expanded="false" aria-controls="faq-answer-6">
						<span class="faq-number">06</span>
						<span class="faq-title">Do you provide maintenance after launch?</span>
						<svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polyline points="6 9 12 15 18 9"/>
						</svg>
					</button>
					<div class="faq-answer" id="faq-answer-6" role="region">
						<div class="faq-answer-inner">
							<p>Yes! I offer continuous support for updates, fixes, and improvements after the website launch.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<CtaSection title="Ready to Create Your Website?" subtitle="Talk to me and get a custom quote!" message="Hi!%20I%20came%20through%20the%20website%20creation%20page%20and%20would%20like%20a%20quote." />
	<Footer copyright="2026 DevIury - Web Designer in Curvelo, Brazil. All rights reserved." />
	<FloatingWhatsApp message="Hi!%20I%20came%20through%20the%20website%20creation%20page%20and%20would%20like%20a%20quote." />

	<script>
		document.querySelectorAll('.faq-question').forEach(button => {
			button.addEventListener('click', () => {
				const item = button.parentElement;
				const isActive = item.classList.contains('active');

				document.querySelectorAll('.faq-item').forEach(faqItem => {
					faqItem.classList.remove('active');
					faqItem.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
				});

				if (!isActive) {
					item.classList.add('active');
					button.setAttribute('aria-expanded', 'true');
				}
			});
		});
	</script>

	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://deviury.com/en/" },
			{ "@type": "ListItem", "position": 2, "name": "Web Design in Curvelo" }
		]
	}
	</script>
</Layout>

<style>
	.hero {
		padding: 8rem 1.5rem 4rem;
	}

	.hero-content {
		max-width: 1100px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: rgba(0, 230, 118, 0.1);
		border: 1px solid rgba(0, 230, 118, 0.2);
		border-radius: 50px;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--primary);
		width: fit-content;
	}

	.hero-text h1 {
		font-size: 3rem;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -1px;
	}

	.hero-text p {
		font-size: 1.1rem;
		color: var(--text-gray);
		max-width: 500px;
	}

	.hero-image img {
		width: 100%;
		max-width: 400px;
		border-radius: 24px;
		border: 2px solid var(--border);
	}

	.cta-group {
		display: flex;
		gap: 1rem;
	}

	.cta-group .btn {
		flex: 1;
		justify-content: center;
		padding: 0.85rem 1.5rem;
		min-width: 0;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.5rem;
		border-radius: 10px;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: all 0.2s;
		color: #fff;
	}

	.btn-primary {
		background: linear-gradient(135deg, #00C853, #00E676, #69F0AE);
		color: #fff;
		font-weight: 700;
	}

	.btn-secondary {
		background: transparent;
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.2);
	}

	.content-seo {
		padding: 4rem 1.5rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.content-seo h2 {
		font-size: 1.75rem;
		margin-bottom: 1rem;
	}

	.content-seo h3 {
		font-size: 1.25rem;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		color: var(--primary);
	}

	.content-seo p {
		color: var(--text-gray);
		line-height: 1.8;
		margin-bottom: 1rem;
	}

	.content-seo a {
		color: var(--primary);
		text-decoration: underline;
	}

	.service-list {
		list-style: none;
		padding: 0;
	}

	.service-list li {
		padding: 0.5rem 0;
		color: var(--text-gray);
		border-bottom: 1px solid var(--border);
	}

	.service-list li::before {
		content: "\2713 ";
		color: var(--primary);
		font-weight: 700;
	}

	.faq {
		padding: 4rem 1.5rem;
		text-align: center;
	}

	.section-tag {
		display: inline-block;
		padding: 0.4rem 1rem;
		background: rgba(0, 230, 118, 0.1);
		border: 1px solid rgba(0, 230, 118, 0.2);
		border-radius: 50px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--primary);
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 1rem;
	}

	.faq h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	.faq-accordion {
		max-width: 750px;
		margin: 3rem auto 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.faq-item {
		background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
		border: 1px solid rgba(255,255,255,0.06);
		border-radius: 16px;
		transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
	}

	.faq-item:hover {
		border-color: rgba(0, 230, 118, 0.2);
		background: linear-gradient(135deg, rgba(0,230,118,0.04) 0%, rgba(255,255,255,0.02) 100%);
	}

	.faq-item.active {
		border-color: rgba(0, 230, 118, 0.3);
		background: linear-gradient(135deg, rgba(0,230,118,0.06) 0%, rgba(255,255,255,0.02) 100%);
		box-shadow: 0 8px 32px rgba(0, 230, 118, 0.08);
	}

	.faq-question {
		width: 100%;
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.5rem 1.75rem;
		background: transparent;
		border: none;
		color: var(--text-white);
		font-size: 1.05rem;
		font-weight: 500;
		text-align: left;
		cursor: pointer;
		transition: all 0.3s ease;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		position: relative;
		z-index: 1;
	}

	.faq-question:hover {
		color: #fff;
	}

	.faq-number {
		flex-shrink: 0;
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		background: rgba(0, 230, 118, 0.1);
		color: var(--primary);
		font-size: 0.85rem;
		font-weight: 700;
		transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
	}

	.faq-item.active .faq-number {
		background: var(--primary);
		color: #0a0a0a;
		transform: scale(1.1);
	}

	.faq-title {
		flex: 1;
	}

	.faq-icon {
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
		color: rgba(255,255,255,0.3);
	}

	.faq-item:hover .faq-icon {
		color: var(--primary);
	}

	.faq-item.active .faq-icon {
		transform: rotate(180deg);
		color: var(--primary);
	}

	.faq-answer {
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.5s cubic-bezier(0.23, 1, 0.32, 1);
		will-change: max-height;
	}

	.faq-item.active .faq-answer {
		max-height: 300px;
	}

	.faq-answer-inner {
		padding: 0 1.75rem 1.75rem 4.5rem;
	}

	.faq-answer p {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.8;
		margin: 0;
	}

	@media (max-width: 768px) {
		.hero-content {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 2.5rem;
		}

		.hero-image {
			order: -1;
		}

		.hero-image img {
			max-width: 220px;
		}

		.hero-text h1 {
			font-size: 2rem;
		}

		.cta-group {
			justify-content: center;
			flex-wrap: wrap;
		}

		.cta-group .btn {
			width: 100%;
		}

		.faq-item.active .faq-number {
			background: var(--primary);
			color: #0a0a0a;
		}

		.faq-item.active .faq-icon {
			transform: rotate(180deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item, .faq-question, .faq-number, .faq-icon, .faq-answer {
			transition: none;
		}
	}
</style>
