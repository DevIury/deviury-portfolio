---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sortedPosts[0];
const rest = sortedPosts.slice(1);

function readingTime(post: any) {
	const words = post.body?.split(/\s+/).length ?? 0;
	return Math.max(1, Math.ceil(words / 200));
}
---

<Layout title="Blog | DevIury - Web Designer em Curvelo/MG">
	<Header whatsappMessage="Ol%C3%A1!%20Vim%20pelo%20blog%20e%20gostaria%20de%20um%20or%C3%A7amento." />

	<main class="blog-page">
		<section class="blog-hero">
			<div class="container">
				<div class="blog-hero__badge">
					<span class="dot"></span>
					Blog
				</div>
				<h1>Artigos sobre <span class="gradient-text">Web Design</span> e Digital</h1>
				<p>Dicas, tutoriais e informações sobre criação de sites, SEO e presença digital para empresas em Curvelo/MG.</p>
			</div>
		</section>

		<section class="blog-content">
			<div class="container">
				<a href={`/blog/${featured.id.replace(/\.md$/, '')}`} class="featured-card">
					<div class="featured-card__image">
						<img src={featured.data.image} alt={featured.data.title} width="800" height="400" loading="eager" />
						<div class="featured-card__overlay"></div>
						<span class="featured-card__badge">Mais lido</span>
					</div>
					<div class="featured-card__content">
						<div class="featured-card__meta">
							<time datetime={featured.data.date.toISOString()}>
								{featured.data.date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}
							</time>
							<span class="dot-sep">·</span>
							<span>{readingTime(featured)} min de leitura</span>
						</div>
						<h2>{featured.data.title}</h2>
						<p>{featured.data.description}</p>
						<div class="featured-card__footer">
							<div class="featured-card__author">
								<div class="author-avatar">DI</div>
								<span>DevIury</span>
							</div>
							<span class="read-btn">Ler artigo →</span>
						</div>
					</div>
				</a>

				{rest.length > 0 && (
					<div class="section-header">
						<h2>Últimos artigos</h2>
					</div>
					<div class="blog-grid">
						{rest.map((post) => (
							<a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="blog-card">
								<div class="blog-card__image">
									<img src={post.data.image} alt={post.data.title} width="400" height="220" loading="lazy" />
									<div class="blog-card__overlay"></div>
									<div class="blog-card__tags">
										{post.data.tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
									</div>
								</div>
								<div class="blog-card__content">
									<div class="blog-card__meta">
										<time datetime={post.data.date.toISOString()}>
											{post.data.date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}
										</time>
										<span class="dot-sep">·</span>
										<span>{readingTime(post)} min</span>
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<div class="blog-card__footer">
										<div class="blog-card__author">
											<div class="author-avatar author-avatar--sm">DI</div>
											<span>DevIury</span>
										</div>
										<span class="read-link">Ler →</span>
									</div>
								</div>
							</a>
						))}
					</div>
				)}
			</div>
		</section>
	</main>

	<Footer />
	<FloatingWhatsApp message="Ol%C3%A1!%20Vim%20pelo%20blog%20e%20gostaria%20de%20um%20or%C3%A7amento." />
</Layout>

<style>
	.blog-page {
		background: var(--bg);
		min-height: 100vh;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* Hero */
	.blog-hero {
		padding: 9rem 1.5rem 3rem;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.blog-hero::before {
		content: '';
		position: absolute;
		top: -200px;
		left: 50%;
		transform: translateX(-50%);
		width: 600px;
		height: 600px;
		background: radial-gradient(circle, rgba(0,230,118,0.08) 0%, transparent 70%);
		pointer-events: none;
	}

	.blog-hero__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1.25rem;
		background: rgba(0, 230, 118, 0.08);
		border: 1px solid rgba(0, 230, 118, 0.2);
		border-radius: 100px;
		font-size: 0.85rem;
		color: var(--primary);
		font-weight: 600;
		margin-bottom: 1.5rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.blog-hero__badge .dot {
		width: 6px;
		height: 6px;
		background: var(--primary);
		border-radius: 50%;
		animation: pulse-dot 2s ease-in-out infinite;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.3; }
	}

	.blog-hero h1 {
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 800;
		line-height: 1.15;
		margin-bottom: 1rem;
		color: var(--text-white);
	}

	.gradient-text {
		background: linear-gradient(135deg, #00E676, #69F0AE);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.blog-hero p {
		color: var(--text-gray);
		font-size: 1.1rem;
		max-width: 550px;
		margin: 0 auto;
		line-height: 1.6;
	}

	/* Content */
	.blog-content {
		padding: 0 0 4rem;
	}

	/* Featured Card */
	.featured-card {
		display: grid;
		grid-template-columns: 1fr 1fr;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 20px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		margin-bottom: 3rem;
	}

	.featured-card:hover {
		border-color: rgba(0, 230, 118, 0.3);
		transform: translateY(-4px);
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), 0 0 40px rgba(0, 230, 118, 0.05);
	}

	.featured-card__image {
		position: relative;
		overflow: hidden;
		min-height: 320px;
	}

	.featured-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.featured-card:hover .featured-card__image img {
		transform: scale(1.05);
	}

	.featured-card__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(0,230,118,0.1) 0%, transparent 60%);
		pointer-events: none;
	}

	.featured-card__badge {
		position: absolute;
		top: 1rem;
		left: 1rem;
		padding: 0.35rem 0.9rem;
		background: var(--primary);
		color: #0a0a0a;
		font-size: 0.75rem;
		font-weight: 700;
		border-radius: 100px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.featured-card__content {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.featured-card__meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--text-gray);
		margin-bottom: 1rem;
	}

	.dot-sep {
		opacity: 0.4;
	}

	.featured-card__content h2 {
		font-size: 1.6rem;
		font-weight: 800;
		line-height: 1.25;
		margin-bottom: 0.75rem;
		color: var(--text-white);
	}

	.featured-card__content p {
		color: var(--text-gray);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.featured-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.featured-card__author,
	.blog-card__author {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.85rem;
		color: var(--text-gray);
	}

	.author-avatar {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: linear-gradient(135deg, #00C853, #00E676);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.7rem;
		font-weight: 700;
		color: #0a0a0a;
	}

	.author-avatar--sm {
		width: 26px;
		height: 26px;
		font-size: 0.6rem;
	}

	.read-btn {
		color: var(--primary);
		font-size: 0.9rem;
		font-weight: 600;
		transition: gap 0.2s;
	}

	/* Section Header */
	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}

	.section-header h2 {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--text-white);
	}

	/* Blog Grid */
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.blog-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		display: flex;
		flex-direction: column;
	}

	.blog-card:hover {
		border-color: rgba(0, 230, 118, 0.3);
		transform: translateY(-6px);
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25), 0 0 30px rgba(0, 230, 118, 0.04);
	}

	.blog-card__image {
		position: relative;
		aspect-ratio: 16/9;
		overflow: hidden;
	}

	.blog-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.blog-card:hover .blog-card__image img {
		transform: scale(1.08);
	}

	.blog-card__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(10,10,10,0.6) 0%, transparent 50%);
		pointer-events: none;
	}

	.blog-card__tags {
		position: absolute;
		bottom: 0.75rem;
		left: 0.75rem;
		display: flex;
		gap: 0.4rem;
	}

	.tag {
		padding: 0.2rem 0.6rem;
		background: rgba(0, 230, 118, 0.15);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(0, 230, 118, 0.25);
		border-radius: 6px;
		font-size: 0.7rem;
		color: var(--primary);
		font-weight: 600;
		text-transform: capitalize;
	}

	.blog-card__content {
		padding: 1.25rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.blog-card__meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		color: var(--text-gray);
		margin-bottom: 0.6rem;
	}

	.blog-card__content h3 {
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.35;
		margin-bottom: 0.5rem;
		color: var(--text-white);
		flex: 1;
	}

	.blog-card__content p {
		color: var(--text-gray);
		font-size: 0.85rem;
		line-height: 1.5;
		margin-bottom: 1rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.blog-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border);
	}

	.read-link {
		color: var(--primary);
		font-size: 0.8rem;
		font-weight: 600;
	}

	/* Mobile */
	@media (max-width: 1024px) {
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.blog-hero {
			padding: 8rem 1.5rem 2rem;
		}

		.blog-hero h1 {
			font-size: 1.8rem;
		}

		.blog-hero p {
			font-size: 1rem;
		}

		.featured-card {
			grid-template-columns: 1fr;
		}

		.featured-card__image {
			min-height: 200px;
		}

		.featured-card__content h2 {
			font-size: 1.3rem;
		}

		.blog-grid {
			grid-template-columns: 1fr;
		}

		.blog-card__content h3 {
			font-size: 1rem;
		}
	}
</style>
