	.area-item {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 2rem;
		text-align: center;
		transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
		position: relative;
		overflow: hidden;
		opacity: 0;
		transform: translateY(20px);
		animation: area-fade-in 0.6s ease forwards;
	}

	.area-item:nth-child(1) { animation-delay: 0.1s; }
	.area-item:nth-child(2) { animation-delay: 0.2s; }
	.area-item:nth-child(3) { animation-delay: 0.3s; }

	@keyframes area-fade-in {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.area-item::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, transparent, var(--primary), transparent);
		opacity: 0;
		transition: opacity 0.4s;
	}

	.area-item::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 0%, rgba(0, 230, 118, 0.08) 0%, transparent 70%);
		opacity: 0;
		transition: opacity 0.4s;
	}

	.area-item:hover {
		border-color: rgba(0, 230, 118, 0.4);
		transform: translateY(-8px);
		box-shadow: 0 20px 40px rgba(0, 230, 118, 0.1), 0 0 0 1px rgba(0, 230, 118, 0.1);
	}

	.area-item:hover::before {
		opacity: 1;
	}

	.area-item:hover::after {
		opacity: 1;
	}

	.area-icon {
		width: 56px;
		height: 56px;
		background: rgba(0, 230, 118, 0.1);
		border-radius: 14px;
